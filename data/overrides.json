{
  "_note": "Corrections to the verbecc dataset, central Catalan. Three mechanisms: 'templates' defines new patterns (Verbiste convention: leading '-' = strip a character from the stem), 'assign' remaps a verb to a template, 'forms' forces explicit forms.",

  "templates": {
    "prendre-compost": {
      "suffix": "dre",
      "indicatiu.present": ["c", "s", "--èn", "em", "eu", "en"],
      "_esempio": "aprendre -> aprenc, aprens, aprèn, aprenem, apreneu, aprenen"
    },
    "treure-compost": {
      "suffix": "eure",
      "indicatiu.present": ["ec", "eus", "eu", "aiem", "aieu", "euen"],
      "_esempio": "treure -> trec, treus, treu, traiem, traieu, treuen"
    },
    "neixer-compost": {
      "suffix": "éixer",
      "indicatiu.present": ["eixo", "eixes", "eix", "aixem", "aixeu", "eixen"],
      "_esempio": "néixer -> neixo, neixes, neix, naixem, naixeu, neixen"
    },
    "empenyer-compost": {
      "suffix": "ènyer",
      "indicatiu.present": ["enyo", "enys", "eny", "enyem", "enyeu", "enyen"],
      "_esempio": "empènyer -> empenyo, empenys, empeny, empenyem, empenyeu, empenyen"
    },
    "torcer-compost": {
      "suffix": "òrcer",
      "indicatiu.present": ["orço", "orces", "orç", "orcem", "orceu", "orcen"],
      "_esempio": "tòrcer -> torço, torces, torç, torcem, torceu, torcen"
    }
  },

